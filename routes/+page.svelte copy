

<script lang="ts">
  import { onMount } from 'svelte';

  
let tasks = $state([
  {
    title: 'Menyelesaikan pekerjaan utama',
    time: '09.00',
    done: false,
    type: 'routine',
    repeat: 'daily',
    days: ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat'],
    date: '',
    deadline: '',
    priority: 'high',
    duration: 60,
    status: 'todo'
  },
  {
    title: 'Belajar dan mengembangkan Personal OS',
    time: '19.00',
    done: false,
    type: 'routine',
    repeat: 'daily',
    days: ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu', 'Minggu'],
    date: '',
    deadline: '',
    priority: 'medium',
    duration: 45,
    status: 'todo'
  },
  {
    title: 'Evaluasi kegiatan hari ini',
    time: '21.00',
    done: false,
    type: 'routine',
    repeat: 'daily',
    days: ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu', 'Minggu'],
    date: '',
    deadline: '',
    priority: 'low',
    duration: 15,
    status: 'todo'
  }
]);


  let newTask = $state('');
  let hasLoaded = $state(false);

let taskType = $state('once');
let taskRepeat = $state('weekly');
let taskDays = $state(['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat']);
let taskDate = $state('');
let taskTime = $state('09:00');
let taskDeadline = $state('');
let taskPriority = $state('medium');
let taskDuration = $state(30);

let editingIndex = $state(-1);
let today = $state(new Date().toLocaleDateString('en-CA'));
let dailyChecks = $state<Record<string, string[]>>({});

  let completedTasks = $derived(
    tasks.filter((task) => task.done).length
  );

  onMount(() => {
    try {
      const savedTasks = localStorage.getItem('personal-os-tasks');

const savedChecks = localStorage.getItem('personal-os-daily-checks');

if (savedChecks) {
  dailyChecks = JSON.parse(savedChecks);
}
      if (savedTasks) {
        const parsedTasks = JSON.parse(savedTasks);

        if (Array.isArray(parsedTasks)) {
          tasks = parsedTasks.map((task) => ({
        ...task,
        id: task.id || crypto.randomUUID()
}));
}
      }
    } catch (error) {
      console.error('Gagal membaca tugas tersimpan:', error);
    }

    hasLoaded = true;
  });

  $effect(() => {
  if (!hasLoaded) return;

  localStorage.setItem('personal-os-tasks', JSON.stringify(tasks));

  localStorage.setItem(
    'personal-os-daily-checks',
    JSON.stringify(dailyChecks)
  );
});

  function isTaskDoneToday(task) {
  return dailyChecks[today]?.includes(task.id) ?? false;
}

function toggleTaskToday(task, checked) {
  const currentChecks = dailyChecks[today] ?? [];

  if (checked && !currentChecks.includes(task.id)) {
    dailyChecks = {
      ...dailyChecks,
      [today]: [...currentChecks, task.id]
    };
  } else if (!checked) {
    dailyChecks = {
      ...dailyChecks,
      [today]: currentChecks.filter((id) => id !== task.id)
    };
  }
}
function addTask() {
  if (!newTask.trim()) return;

  const task = {
    id: crypto.randomUUID(),
    title: newTask.trim(),
    time: taskTime,
    done: false,
    type: taskType,
    repeat: taskType === 'routine' ? taskRepeat : 'once',
    days: taskType === 'routine' ? [...taskDays] : [],
    date: taskDate,
    deadline: taskDeadline,
    priority: taskPriority,
    duration: taskDuration,
    status: 'todo'
  };

  if (editingIndex >= 0) {
    tasks = tasks.map((item, index) =>
      index === editingIndex ? { ...item, ...task } : item
    );
  } else {
    tasks = [...tasks, task];
  }

  newTask = '';
  editingIndex = -1;
}


function editTask(index: number) {
  const task = tasks[index];

  newTask = task.title;
  taskType = task.type ?? 'once';
  taskRepeat = task.repeat ?? 'weekly';
  taskDays = Array.isArray(task.days) ? [...task.days] : [];
  taskDate = task.date ?? '';
  taskTime = task.time ?? '09:00';
  taskDeadline = task.deadline ?? '';
  taskPriority = task.priority ?? 'medium';
  taskDuration = task.duration ?? 30;

  editingIndex = index;
}

function deleteTask(index: number) {
  const confirmed = confirm('Yakin ingin menghapus kegiatan ini?');

  if (!confirmed) return;

  tasks = tasks.filter((_, i) => i !== index);

  if (editingIndex === index) {
    newTask = '';
    editingIndex = -1;
  } else if (editingIndex > index) {
    editingIndex -= 1;
  }
}

function getTodayDate() {
  const now = new Date();
  const year = now.getFullYear();
  const month = String(now.getMonth() + 1).padStart(2, '0');
  const day = String(now.getDate()).padStart(2, '0');

  return `${year}-${month}-${day}`;
}

function getTodayName() {
  const days = [
    'Minggu',
    'Senin',
    'Selasa',
    'Rabu',
    'Kamis',
    'Jumat',
    'Sabtu'
  ];

  return days[new Date().getDay()];
}

function isTaskScheduledToday(task: (typeof tasks)[number]) {
  const today = getTodayDate();
  const todayName = getTodayName();

  if (task.type === 'routine') {
    if (task.repeat === 'monthly') {
      return task.date !== '' &&
        Number(task.date.split('-')[2]) === Number(today.split('-')[2]);
    }

    if (task.repeat === 'weekly' || task.repeat === 'daily') {
      return Array.isArray(task.days) && task.days.includes(todayName);
    }

    return false;
  }

  // Tugas dadakan hanya berlaku pada tanggal yang dipilih.
  return task.date === today;
}

</script>
 

